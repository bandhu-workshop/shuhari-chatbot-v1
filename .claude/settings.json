{
  "permissions": {
    "ask": [
      "Edit(AGENTS.md)",
      "Edit(backend/AGENTS.md)",
      "Edit(frontend/AGENTS.md)",
      "Edit(**/AGENTS.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-agents-md.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
